# Server-side only. Never expose this key with a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=your_openai_api_key_here

# Optional. TestForge defaults to gpt-5.6 when this is not set.
OPENAI_MODEL=gpt-5.6

# Supabase project settings. The anon key is safe to expose to the browser when Row Level Security is enabled.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
